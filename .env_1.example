# Copy this file to .env and fill in your real values.
# .env is already excluded via .gitignore -- never commit real credentials.

USERNAME_WEBHOOK=your_webhook_username
PASSWORD_WEBHOOK=your_webhook_password

HOST_DATABASE=your_postgres_host
PORT_DATABASE=5432
DATABASE=your_database_name
USER_DATABASE=your_postgres_user
PASSWORD_DATABASE=your_postgres_password
